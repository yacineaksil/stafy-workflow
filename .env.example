# ── LLM ──────────────────────────────────────────────────────────────────────
# "ollama" = gratuit, local | "anthropic" = payant, cloud
LLM_PROVIDER=ollama

# Ollama (si LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Anthropic (si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Email IMAP ────────────────────────────────────────────────────────────────
IMAP_HOST=mail.votredomaine.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_USERNAME=vous@votredomaine.com
IMAP_PASSWORD=votre_mot_de_passe

SMTP_HOST=mail.votredomaine.com
SMTP_PORT=587

# ── Agent ─────────────────────────────────────────────────────────────────────
MAX_EMAILS_PER_FETCH=50
REFRESH_INTERVAL_MINUTES=30
AGENT_LANGUAGE=fr

# ── Base de données ───────────────────────────────────────────────────────────
STAFY_DB_PATH=/home/USERNAME/stafy-workflow/stafy.db

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme_mot_de_passe_fort
SECRET_KEY=generez-une-cle-aleatoire-longue-ici
