# Copie ce fichier en `.env` et mets ta vraie clé API-Sports.
# Le fichier `.env` est ignoré par git (voir .gitignore) — ne le commit jamais.
APISPORTS_KEY=ta_cle_api_sports_ici

# Nom du bookmaker à cibler pour la détection de value (tel qu'il apparait dans l'API).
BOOKMAKER_NAME=1xBet

# Seuil minimum de value pour qu'un pari soit recommandé (0.05 = 5%).
MIN_VALUE=0.05

# Fraction de Kelly (0.25 = quart de Kelly, prudent et recommandé).
KELLY_FRACTION=0.25
