# Clé API Anthropic (obligatoire)
ANTHROPIC_API_KEY=sk-ant-...

# Fichiers OAuth Google (générés par setup_oauth.py)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Paramètres dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Nombre maximum d'emails récupérés par session
MAX_EMAILS_PER_FETCH=50

# Langue des réponses générées
AGENT_LANGUAGE=fr
